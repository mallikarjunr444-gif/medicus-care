{
  "mcpServers": {
    "shadcn": {
      "command": "npx",
      "args": ["shadcn@latest", "mcp"]
    },
    "spectrum-ui": {
      "command": "npx",
      "args": ["-y", "@spectrumui/mcp"]
    },
    "ai-canvas": {
      "command": "npx",
      "args": ["-y", "@aicanvas/mcp"]
    },
    "eneui": {
      "type": "http",
      "url": "https://ui.eneawork.it/mcp"
    },
    "21st": {
      "type": "http",
      "url": "https://21st.dev/api/mcp",
      "headers": {
        "x-api-key": "${TWENTY_FIRST_API_KEY}"
      }
    }
  }
}
